# Copy to mobile/.env (git-ignored) or set as EAS build environment variables.
# EXPO_PUBLIC_* values are inlined into the app bundle at build time, so only
# public values belong here: never a Supabase service-role key.

# HTTPS URL of the Vercel deployment of the API (no trailing slash).
# Release builds without it report not_configured for the 3D demo and clip sync;
# development builds fall back to http://localhost:3001.
EXPO_PUBLIC_API_URL=https://your-project.vercel.app

# Supabase project used for sign-in. Without both, every player counts as
# signed out and no shot clip ever uploads.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
