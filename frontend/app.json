{
  "expo": {
    "name": "Peek",
    "slug": "perspective",
    "version": "0.2.12",
    "icon": "./assets/peek/logo.png",
    "scheme": "perspective",
    "platforms": ["ios"],
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.andrewww8.perspective",
      "supportsTablet": false,
      "buildNumber": "14"
    },
    "plugins": [
      ["expo-camera", {
        "cameraPermission": "Peek uses the camera to record your basketball practice.",
        "recordAudioAndroid": false,
        "microphonePermission": false
      }],
      ["expo-secure-store", { "faceIDPermission": false }],
      ["expo-image-picker", {
        "photosPermission": "Peek lets you choose a basketball practice video from your photo library.",
        "cameraPermission": "Peek uses the camera to record your basketball practice.",
        "microphonePermission": false
      }]
    ]
  }
}
