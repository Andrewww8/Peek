EXPO_PUBLIC_API_URL=https://perspective-api-eta.vercel.app
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Guest analyses have no daily cap by default. Set this to 5 for the previous on-device limit.
# EXPO_PUBLIC_PEEK_GUEST_DAILY_LIMIT=5
# For a project still using its legacy public anon key, replace the publishable key variable with:
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
