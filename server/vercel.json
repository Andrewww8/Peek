{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "{catalog/**,node_modules/ffmpeg-static/**,node_modules/@langchain/langgraph-sdk/dist/node_modules/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
